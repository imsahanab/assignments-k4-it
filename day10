const couchbase = require("couchbase");
require("dotenv").config();

// 🔍 Debug
console.log("URL :", process.env.CB_URL);
console.log("USER:", process.env.CB_USER);
console.log("PASS:", process.env.CB_PASS ? "********" : "Not Found");

async function main() {
  let cluster;

  try {
    console.log("🔄 Connecting to Couchbase...");

    cluster = await couchbase.connect(process.env.CB_URL, {
      username: process.env.CB_USER,
      password: process.env.CB_PASS,
      timeouts: {
        connectTimeout: 10000,
        kvTimeout: 5000,
      },
    });

    console.log("✅ Connected!");

    const bucket = cluster.bucket("mybuck");
    const collection = bucket.defaultCollection();

    // Insert document
    await collection.upsert("emp1", {
      id: 1,
      name: "Sahana",
      role: "Developer",
    });

    console.log("✅ Document inserted: emp1");

    // Get document
    const result = await collection.get("emp1");
    console.log("📄 Fetched document:", result.content);

    // Update document
    await collection.upsert("emp1", {
      id: 1,
      name: "Sahana",
      role: "Senior Developer",
    });

    console.log("✅ Document updated: emp1");

    // Query document
    const query = `
      SELECT *
      FROM \`mybuck\`._default._default
      WHERE \`role\` = $1
    `;

    const queryResult = await cluster.query(query, {
      parameters: ["Senior Developer"],
    });

    console.log("🔍 Query Results:");
    queryResult.rows.forEach((row) => {
      console.log(row);
    });

  } catch (err) {
    console.error("❌ Error:", err);
  } finally {
    if (cluster) {
      await cluster.close();
      console.log("🔒 Connection closed");
    }
  }
}

main();
