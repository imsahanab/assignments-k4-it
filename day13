const couchbase = require("couchbase");

async function main() {
  const cluster = await couchbase.connect(
    "couchbases://cb.24jsbijb9lgaf0vf.cloud.couchbase.com",
    {
      username: "saha",
      password: "Saha0208#"
    }
  );

  const bucket = cluster.bucket("mybuck");
  const collection = bucket.defaultCollection();

  console.time("Insert Time");

  for (let batch = 1; batch <= 10000; batch += 100) {
    const promises = [];

    for (let i = batch; i < batch + 100 && i <= 10000; i++) {
      promises.push(
        collection.upsert(`user_${i}`, {
          id: i,
          name: `User ${i}`,
          city: i % 2 === 0 ? "Chennai" : "Bangalore"
        })
      );
    }

    await Promise.all(promises);
    console.log(`Inserted till ${Math.min(batch + 99, 10000)}`);
  }

  console.timeEnd("Insert Time");
}

main().catch(console.error);
